{
  "name": "steam-account-auditor",
  "version": "1.0.0",
  "description": "Audit Steam accounts you own: resolve SteamID64s from account credentials and check VAC / community / trade ban status via the Steam Web API.",
  "main": "src/checkBans.js",
  "scripts": {
    "extract-ids": "node bin/extract-ids.js",
    "check-bans": "node bin/check-bans.js"
  },
  "bin": {
    "steam-extract-ids": "bin/extract-ids.js",
    "steam-check-bans": "bin/check-bans.js"
  },
  "keywords": [
    "steam",
    "steamid",
    "vac",
    "ban-check",
    "steam-web-api"
  ],
  "author": "ImpLeax",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "steam-user": "^5.3.0"
  }
}
