# Copy this file to .env and fill in real values. Never commit .env.

# Steam Web API key (required for check-bans). Get one at:
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_web_api_key_here

# --- IMAP (required for extract-ids when accounts have Steam Guard) ---
IMAP_HOST=imap.firstmail.ltd
IMAP_PORT=993
IMAP_SECURE=true
IMAP_SOCKET_TIMEOUT_MS=15000
IMAP_ATTEMPTS=12
IMAP_RETRY_DELAY_MS=2000
STEAM_GUARD_FROM=noreply@steampowered.com

# --- Extraction tuning ---
CONCURRENCY=5
CONNECT_TIMEOUT_MS=25000
AFTER_CODE_TIMEOUT_MS=15000

# --- IP rotation (optional; requires an ADB-connected phone) ---
IP_ROTATION_ENABLED=false
IP_ROTATION_DISABLE_DELAY_MS=3000
IP_ROTATION_ENABLE_DELAY_MS=8000

# --- Ban check ---
BAN_CHECK_CHUNK_SIZE=100

# --- Misc ---
# Override the data directory (defaults to ./data)
# DATA_DIR=./data
# Log verbosity: error | warn | info | debug
LOG_LEVEL=info
